generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id           String      @id @default(uuid()) @db.Uuid
  email        String      @unique
  firstName    String
  lastName     String
  initials     String      @unique
  phone        String?
  position     String?
  defaultMpkId String?     @db.Uuid
  globalRole   GlobalRole?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  defaultMpk MPK?       @relation("UserDefaultMPK", fields: [defaultMpkId], references: [id])
  offers     Offer[]    @relation("OfferAuthor")
  userMPKs   UserMPK[]
  auditLogs  AuditLog[]
}

enum GlobalRole {
  FINANCE
  EXEC
  ADMIN
}

model MPK {
  id       String  @id @default(uuid()) @db.Uuid
  code3    String  @unique @db.Char(3)
  name     String
  street   String?
  postcode String?
  city     String?
  active   Boolean @default(true)

  users            UserMPK[]
  clients          ClientMPK[]
  offers           Offer[]
  offerNoSequences OfferNoSequence[]
  usersDefault     User[]            @relation("UserDefaultMPK")
}

model UserMPK {
  userId String      @db.Uuid
  mpkId  String      @db.Uuid
  role   UserMPKRole

  user User @relation(fields: [userId], references: [id])
  mpk  MPK  @relation(fields: [mpkId], references: [id])

  @@id([userId, mpkId])
}

enum UserMPKRole {
  LEADER
  MANAGER
  PM
  VIEWER
}

model Client {
  id       String  @id @default(uuid()) @db.Uuid
  nip      String  @unique
  name     String
  street   String?
  postcode String?
  city     String?
  isActive Boolean @default(true)
  notes    String?
  meta     Json?

  mpks     ClientMPK[]
  contacts ClientContact[]
  offers   Offer[]
}

model ClientMPK {
  clientId     String  @db.Uuid
  mpkId        String  @db.Uuid
  billingNotes String?

  client Client @relation(fields: [clientId], references: [id])
  mpk    MPK    @relation(fields: [mpkId], references: [id])

  @@id([clientId, mpkId])
}

model ClientContact {
  id        String  @id @default(uuid())
  clientId  String  @db.Uuid
  firstName String
  lastName  String
  email     String?
  phone     String?
  roleTitle String?
  isActive  Boolean @default(true)
  meta      Json?

  client Client  @relation(fields: [clientId], references: [id])
  offers Offer[] @relation("OfferClientContact")
}

model Offer {
  id              String      @id @default(uuid())
  offerNo         String?     @unique
  mpkId           String?     @db.Uuid
  clientId        String      @db.Uuid
  clientContactId String?
  title           String
  valueNet        Decimal     @db.Decimal(12, 2)
  currency        String      @default("PLN")
  authorUserId    String      @db.Uuid
  status          OfferStatus
  createdAt       DateTime    @default(now())
  finalizedAt     DateTime?
  meta            Json?
  costsSumNet     Decimal     @default(0) @db.Decimal(12, 2)
  cancelledAt     DateTime?   @db.Timestamptz

  mpk           MPK?             @relation(fields: [mpkId], references: [id])
  client        Client           @relation(fields: [clientId], references: [id])
  clientContact ClientContact?   @relation("OfferClientContact", fields: [clientContactId], references: [id])
  author        User             @relation("OfferAuthor", fields: [authorUserId], references: [id])
  items         OfferItem[]
  terms         OfferTerms?
  milestones    OfferMilestone[]
  documents     OfferDocument[]
  costs         OfferCost[]
  auditLogs     AuditLog[]

  @@index([mpkId])
  @@index([clientId])
  @@index([createdAt(sort: Desc)])
  @@index([finalizedAt(sort: Desc)])
  @@index([offerNo])
  @@index([cancelledAt])
}

enum OfferStatus {
  DRAFT
  FINAL
  SENT
  EXECUTED
  CLOSED
}

model OfferItem {
  id             String   @id @default(uuid())
  offerId        String
  lp             Int
  name           String
  qty            Decimal  @default(1) @db.Decimal(12, 3)
  unit           String   @db.VarChar(12)
  priceSuggested Decimal? @db.Decimal(12, 2)
  totalSuggested Decimal? @db.Decimal(12, 2)
  priceOnOffer   Decimal? @db.Decimal(12, 2)
  totalOnOffer   Decimal? @db.Decimal(12, 2)
  showOnOffer    Boolean  @default(true)
  meta           Json?

  offer Offer @relation(fields: [offerId], references: [id])
}

model OfferTerms {
  id           String  @id @default(uuid())
  offerId      String  @unique
  validityDays Int
  deliveryDesc String
  vatRate      Decimal @db.Decimal(4, 2)
  meta         Json?

  offer Offer @relation(fields: [offerId], references: [id])
}

enum OfferMilestoneStep {
  WYSLANIE
  AKCEPTACJA
  WYKONANIE
  PROTOKOL_WYSLANY
  ODBIOR_PRAC
  PWF
}

model OfferMilestone {
  id         String             @id @default(uuid())
  offerId    String
  step       OfferMilestoneStep
  occurredAt DateTime

  offer Offer @relation(fields: [offerId], references: [id])

  @@unique([offerId, step])
}

enum OfferDocumentType {
  OFFER
  PROTOKOL
  PWF
}

enum OfferDocumentStatus {
  DRAFT
  FINAL
  SENT
}

model OfferDocument {
  id          String              @id @default(uuid())
  offerId     String
  type        OfferDocumentType
  status      OfferDocumentStatus
  version     Int
  fileKey     String
  fileName    String
  mime        String
  sizeBytes   BigInt
  sha256      String              @db.Char(64)
  generatedAt DateTime
  sentAt      DateTime?
  metadata    Json?

  offer Offer @relation(fields: [offerId], references: [id])

  @@index([offerId, type, version(sort: Desc)])
}

model OfferNoSequence {
  mpkId    String @db.Uuid
  yyyymmdd String @db.Char(8)
  initials String @db.Char(4)
  lastNo   Int

  mpk MPK @relation(fields: [mpkId], references: [id])

  @@id([mpkId, yyyymmdd, initials])
}

model OfferCost {
  id        String   @id @default(uuid())
  offerId   String
  postedAt  DateTime
  category  String   @db.VarChar(32)
  vendor    String   @db.VarChar(128)
  invoiceNo String   @db.VarChar(64)
  amountNet Decimal  @db.Decimal(12, 2)
  meta      Json?

  offer Offer @relation(fields: [offerId], references: [id])

  @@index([offerId, postedAt])
}

model AuditLog {
  id      String   @id @default(uuid())
  userId  String   @db.Uuid
  offerId String?
  action  String
  at      DateTime
  meta    Json?

  user  User   @relation(fields: [userId], references: [id])
  offer Offer? @relation(fields: [offerId], references: [id])
}
